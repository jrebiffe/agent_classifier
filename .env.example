# Copy to .env and fill in. The CLI/library reads these at runtime.

# Required: credentials for the model provider you choose.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the classifier model. Any init_chat_model id works,
# e.g. anthropic:claude-opus-4-8 for depth, or openai:gpt-5.5 (needs
# langchain-openai installed + OPENAI_API_KEY) or ollama:... for local.
AGENT_CLASSIFIER_MODEL=anthropic:claude-sonnet-4-6

# Optional: sampling temperature. 0 keeps classification stable.
AGENT_CLASSIFIER_TEMPERATURE=0
